<form class="gum-hud-execution-form">
  <header class="gum-hud-execution-toolbar">
    <label>{{labels.actor}}<select data-actor>{{#each actors as |actor|}}<option value="{{actor.uuid}}" {{#if actor.selected}}selected{{/if}}>{{actor.name}}</option>{{/each}}</select></label>
    <label>{{labels.maneuver}}<select data-maneuver>{{#each maneuvers as |maneuver|}}<option value="{{maneuver.uuid}}" {{#if maneuver.selected}}selected{{/if}}>{{maneuver.name}}</option>{{/each}}</select></label>
  </header>
  {{#if hasContext}}
    <section class="gum-hud-execution-adders">
      <div><label>{{labels.modifier}}<select data-modifier-source><option value=""></option>{{#each modifiers as |modifier|}}<option value="{{modifier.uuid}}">{{modifier.name}}</option>{{/each}}</select></label><button type="button" data-add-modifier><i class="fas fa-plus"></i> {{labels.addModifier}}</button></div>
      <div><label>{{labels.effectUuid}}<input type="text" data-effect-uuid placeholder="Compendium.…"/></label><button type="button" data-add-effect><i class="fas fa-plus"></i> {{labels.addEffect}}</button></div>
      <p><i class="fas fa-hand-pointer"></i> {{labels.dropHint}}</p>
    </section>
    <div class="gum-hud-execution-list" data-binding-list>
      {{#each bindings as |binding|}}
        <article class="gum-hud-execution-binding {{#if binding.missing}}is-missing{{/if}}" data-binding-id="{{binding.id}}">
          <img src="{{binding.img}}" alt=""/><div class="gum-hud-execution-source"><strong>{{binding.name}}</strong><small>{{#if binding.isEffect}}{{../labels.globalEffect}}{{else}}{{../actorName}}{{/if}}</small></div>
          <label>{{../labels.group}}<input type="text" data-binding-field="group" value="{{binding.group}}" {{#if binding.behaviorLocked}}disabled{{/if}}/></label>
          <label>{{../labels.mode}}<select data-binding-field="mode" {{#if binding.behaviorLocked}}disabled{{/if}}><option value="exclusive" {{#if (eq binding.mode "exclusive")}}selected{{/if}}>{{../labels.exclusive}}</option><option value="cumulative" {{#if (eq binding.mode "cumulative")}}selected{{/if}}>{{../labels.cumulative}}</option></select></label>
          {{#if binding.isModifier}}<label>{{../labels.reset}}<select data-binding-field="reset"><option value="after_roll" {{#if (eq binding.reset "after_roll")}}selected{{/if}}>{{../labels.afterRoll}}</option><option value="sticky" {{#if (eq binding.reset "sticky")}}selected{{/if}}>{{../labels.sticky}}</option></select></label>{{/if}}
          <button type="button" data-remove-binding="{{binding.id}}" title="{{../labels.remove}}"><i class="fas fa-trash"></i></button>
        </article>
      {{else}}<p class="gum-hud-execution-empty">{{labels.empty}}</p>{{/each}}
    </div>
  {{else}}
    <p class="gum-hud-execution-empty">{{#unless actors.length}}{{labels.noActors}}{{else}}{{labels.noManeuvers}}{{/unless}}</p>
  {{/if}}
</form>
