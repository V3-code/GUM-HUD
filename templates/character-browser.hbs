<form class="gum-hud-browser-form">
  <nav class="gum-hud-browser-tabs" aria-label="{{actorName}}">
    {{#each tabs as |tab|}}<button type="button" data-browser-category="{{tab.id}}" class="{{#if tab.active}}is-active{{/if}}" title="{{tab.label}}"><i class="{{tab.icon}}"></i><span>{{tab.label}}</span></button>{{/each}}
  </nav>
  <div class="gum-hud-browser-tools">
    <label><i class="fas fa-magnifying-glass"></i><input type="search" data-browser-search value="{{query}}" placeholder="{{searchPlaceholder}}" autocomplete="off"/></label>
    {{#if isEquipment}}<div class="gum-hud-browser-filters">{{#each equipmentFilters as |filter|}}<button type="button" data-equipment-filter="{{filter.id}}" class="{{#if filter.active}}is-active{{/if}}">{{filter.label}}</button>{{/each}}</div>{{/if}}
  </div>
  <div class="gum-hud-browser-content">
    {{#each groups as |group|}}
      <section class="gum-hud-browser-group" data-browser-group>
        <header><span>{{group.name}}</span></header>
        <div class="gum-hud-browser-grid">
          {{#each group.items as |item|}}
            <article class="gum-hud-resource-card {{#if item.expanded}}is-expanded{{/if}}" data-browser-item="{{item.id}}" data-search="{{item.search}}">
              <div class="gum-hud-resource-main">
                <img src="{{item.img}}" alt=""/>
                <strong title="{{item.name}}">{{item.name}}</strong>
                {{#if item.favorite}}<i class="fas fa-star gum-hud-resource-favorite" aria-label="{{../../favoriteLabel}}"></i>{{/if}}
                {{#if item.showQuantity}}<small title="{{../../quantityLabel}}">×{{item.quantity}}</small>{{/if}}
                {{#if item.canRoll}}<button type="button" class="gum-hud-resource-value" data-roll-ability="{{item.id}}" title="{{../../rollLabel}} {{item.name}}"><span>{{../../skillLevelAbbrev}}</span><b>{{item.nh}}</b></button>{{/if}}
                {{#if item.hasDetails}}<button type="button" class="gum-hud-resource-expand" data-expand-item="{{item.id}}" aria-expanded="{{item.expanded}}"><i class="fas fa-chevron-{{#if item.expanded}}up{{else}}down{{/if}}"></i></button>{{/if}}
              </div>
              {{#if item.expanded}}<div class="gum-hud-resource-actions">
                {{#if item.usesAttack}}<button type="button" data-roll-ability-attack="{{item.id}}"><small>{{../../attackLabel}}</small><b>{{item.attackNh}}</b></button>{{/if}}
                {{#if item.directDamage}}<button type="button" data-roll-damage-item="{{item.id}}"><small>{{../../damageLabel}}</small><b>{{item.directDamage}}</b></button>{{/if}}
                {{#each item.attacks as |attack|}}<div class="gum-hud-resource-attack"><span title="{{attack.name}}">{{attack.name}}</span><button type="button" data-item-id="{{../id}}" data-roll-attack="{{attack.id}}"><small>{{../../../skillLevelAbbrev}}</small><b>{{attack.nh}}</b></button>{{#if attack.canDamage}}<button type="button" data-item-id="{{../id}}" data-roll-damage-attack="{{attack.id}}"><small>{{../../../damageLabel}}</small><b>{{attack.damage}}</b></button>{{/if}}</div>{{/each}}
                {{#if item.consumable}}<button type="button" data-use-consumable="{{item.id}}" {{#unless item.canConsume}}disabled{{/unless}}><small>{{../../useLabel}}</small><b>{{item.consumptionDisplay}}</b></button>{{/if}}
              </div>{{/if}}
            </article>
          {{/each}}
        </div>
      </section>
    {{/each}}
    <p class="gum-hud-browser-empty" data-browser-search-empty hidden>{{empty}}</p>
  </div>
  <footer><i class="fas fa-circle-info"></i> {{quickViewHint}}</footer>
</form>
